{
  "name": "Control de pan - enviar PDF al dueño",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "control-pan",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://delaguardaagustin.github.io"
        }
      },
      "id": "4f7e2a10-1c3b-4d55-9a61-0b2f7c3e9a01",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "b6f0c7a2-6d1e-4e2b-8f3c-5a7d9e1f2b04"
    },
    {
      "parameters": {
        "jsCode": "// Solo se envía a correos autorizados: la app es pública y sin esto cualquiera podría usar este Gmail para mandar correos.\nconst PERMITIDOS = ['delaguardaagustin@gmail.com'];\nconst b = $input.first().json.body || {};\nconst correo = String(b.correo || '').trim().toLowerCase();\nconst bin = $input.first().binary || {};\nconst ok = PERMITIDOS.includes(correo) && !!bin.pdf && (bin.pdf.mimeType || '').includes('pdf');\nreturn [{ json: { ...$input.first().json, permitido: ok, correo }, binary: bin }];"
      },
      "id": "d1e2f3a4-5b6c-4d7e-8f90-a1b2c3d4e5f6",
      "name": "Revisar correo autorizado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "a9b8c7d6-e5f4-4a3b-9c2d-1e0f9a8b7c6d",
              "leftValue": "={{ $json.permitido }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e1f2a3b4-c5d6-4e7f-8a9b-0c1d2e3f4a5b",
      "name": "¿Autorizado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        400,
        0
      ]
    },
    {
      "id": "9a3d5b21-7e4f-4c10-8b22-1d4e6f8a0b02",
      "name": "Enviar correo con PDF",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        640,
        -40
      ],
      "parameters": {
        "fromEmail": "Control de pan <delaguardaagustin@gmail.com>",
        "toEmail": "={{ $json.correo }}",
        "subject": "=Control de pan – {{ $('Webhook').item.json.body.local }} – {{ $('Webhook').item.json.body.fechas }}",
        "emailFormat": "text",
        "text": "=Hola,\n\nSe adjunta el control de pan de {{ $('Webhook').item.json.body.local }} ({{ $('Webhook').item.json.body.mes }}), fechas {{ $('Webhook').item.json.body.fechas }}.\nTotal de la semana: {{ $('Webhook').item.json.body.total }}.\n\nEnviado desde la app Control de pan.",
        "options": {
          "attachments": "pdf",
          "appendAttribution": false
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": true}",
        "options": {}
      },
      "id": "c2b8e4f3-0a6d-4e7b-9c33-2e5f7a9b1c03",
      "name": "Responder a la app",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        -40
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": false, \"error\": \"correo no autorizado\"}",
        "options": {
          "responseCode": 403
        }
      },
      "id": "f1a2b3c4-d5e6-4f70-8192-a3b4c5d6e7f8",
      "name": "Rechazar",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        640,
        180
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Revisar correo autorizado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Revisar correo autorizado": {
      "main": [
        [
          {
            "node": "¿Autorizado?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Autorizado?": {
      "main": [
        [
          {
            "node": "Enviar correo con PDF",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Rechazar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar correo con PDF": {
      "main": [
        [
          {
            "node": "Responder a la app",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}